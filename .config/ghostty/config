# --- APPEARANCE ---
# luna: near-black greys with four accent hues, matching the nvim colorscheme
# (wtfox/luna.nvim) so the editor and terminal chrome agree. Not a built-in
# theme -- it's a local file in ./themes/, which Ghostty resolves before its
# bundled themes. Pinned to a single name on purpose: the `light:x,dark:y` form
# follows the system appearance, which we don't want.
theme = luna
font-size = 14

# Nudge dim/low-contrast ANSI colours until they're legible against the
# background, without flattening the palette (1.0 = no adjustment).
minimum-contrast = 1.1

# Frosted background, similar to Warp's translucent window.
background-opacity = 0.96
background-blur = 20

# Steady block cursor is less distracting than a blinking bar during long reads.
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

# Breathing room around the grid; balance splits padding evenly.
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true

keybind = Home=scroll_to_top
keybind = End=scroll_to_bottom

# Clipboard: Linux has two clipboards (PRIMARY/selection vs CLIPBOARD) and Ctrl
# is overloaded, unlike macOS (⌘ + one clipboard). Make copy/paste consistent:
copy-on-select = clipboard
right-click-action = copy-or-paste
keybind = performable:ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard

# --- QUAKE MODE (QUICK TERMINAL) ---
# Maps Command + ` to globally toggle the dropdown terminal
keybind = global:cmd+grave_accent=toggle_quick_terminal

# --- QUICK TERMINAL CUSTOMIZATION ---
# Set the dropdown height (60% of the screen height works best)
quick-terminal-size = 60%

# Screen position (top, bottom, left, right)
quick-terminal-position = top

# Automatically slide away when you click onto another application
quick-terminal-autohide = true

# --- TAB BEHAVIOUR ---
# `tab-style` was never a real Ghostty option (silently invalid until 1.3's
# stricter validation). On macOS, tabs live in the titlebar via this key.
macos-titlebar-style = tabs

# Disable dimming for inactive split panes
unfocused-split-opacity = 1.0
