# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor backups
*.bak
*.swp
*.swo
*~

# Neovim/Vim temporary files
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]

# Logs
*.log

# Temporary files
tmp/
temp/

# Secrets (tokens, API keys, credentials)
.zshrc.secrets

# Large binaries / AppImages (not dotfiles)
*.AppImage

# Albert rewrites its own config dir at runtime; track only the config file
/home/dot_config/albert/*
!/home/dot_config/albert/config
