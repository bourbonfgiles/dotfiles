
################################################################################
# History
################################################################################
HISTIGNORE='cps*:cps *:cps:cpe*:cpe: cpe *:history:ll:ls:z:exit:k9s'
HISTSIZE=10000
SAVEHIST=20000

################################################################################
# Homebrew PATH (macOS + Linux)
# Ensure brewed tools are on PATH across shells (official shellenv method).     #
################################################################################
# Warp often starts non‑login shells; pull in ~/.zprofile where brew shellenv lives.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [[ -x "$HOME/.linuxbrew/bin/brew" ]]; then
  eval "$("$HOME/.linuxbrew/bin/brew" shellenv)"
fi
# Also source ~/.zprofile if present (local, non-tracked additions).
[[ -r "$HOME/.zprofile" ]] && source "$HOME/.zprofile"

################################################################################
# Zsh completion system (must be before any compdef/completion usage)
################################################################################
autoload -Uz compinit

# Cache gh / kubectl / helm completions to a dir on $fpath, regenerating a file
# only when its binary is newer. compinit then loads them from disk, so no
# completion subprocess spawns per shell. Must run before compinit.
_zcompcache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/completions"
mkdir -p "$_zcompcache"
fpath=("$_zcompcache" $fpath)
_cache_completion() {
  local tool="$1" file="$_zcompcache/_$1"
  command -v "$tool" >/dev/null || return
  if [[ ! -f "$file" || "$(command -v "$tool")" -nt "$file" ]]; then
    case "$tool" in
      gh) gh completion -s zsh >"$file" ;;
      *)  "$tool" completion zsh >"$file" ;;
    esac
  fi
}
_cache_completion gh
_cache_completion kubectl
_cache_completion helm

# Cache the completion dump; rebuild it only once a day (-C skips the security
# check on the cached dump, making subsequent shells start noticeably faster).
_zcompdump="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump"
mkdir -p "${_zcompdump:h}"
if [[ -n "$_zcompdump"(#qN.mh+24) ]]; then
  compinit -i -d "$_zcompdump"
else
  compinit -C -i -d "$_zcompdump"
fi

################################################################################
# Aliases
################################################################################
alias ll='eza -la --group-directories-first --icons --color=always --header'
alias z='zoxide'
alias top='btm'
if command -v xclip >/dev/null; then
  alias xclip='xclip -selection clipboard'
fi

################################################################################
# zoxide
################################################################################
if command -v zoxide >/dev/null; then
  eval "$(zoxide init zsh)"
fi

################################################################################
# Starship Prompt
################################################################################
if command -v starship >/dev/null; then
  eval "$(starship init zsh)"
fi

################################################################################
# Carapace Completions
################################################################################
if command -v carapace >/dev/null; then
  eval "$(carapace _carapace)"
fi

################################################################################
# fzf (key-bindings + completion)
################################################################################
if command -v brew >/dev/null; then
  FZF_PREFIX="$(brew --prefix)"
  [[ -f "${FZF_PREFIX}/opt/fzf/shell/key-bindings.zsh" ]] && source "${FZF_PREFIX}/opt/fzf/shell/key-bindings.zsh"
  [[ -f "${FZF_PREFIX}/opt/fzf/shell/completion.zsh"    ]] && source "${FZF_PREFIX}/opt/fzf/shell/completion.zsh"
fi

################################################################################
# eza Theme Path (cross‑platform)
################################################################################
export EZA_CONFIG_DIR="$HOME/.config/eza"

################################################################################
# Editor
################################################################################
if command -v nvim >/dev/null; then
  export EDITOR="nvim"
  export VISUAL="nvim"
elif command -v vim >/dev/null; then
  export EDITOR="vim"
  export VISUAL="vim"
fi

################################################################################
# Terraform version management (tenv)
################################################################################
export TENV_AUTO_INSTALL=true

################################################################################
# Docker API socket for k3d: rootful Podman (machine on macOS, system on Linux)
################################################################################
if [[ "$OSTYPE" == darwin* ]] && command -v podman >/dev/null; then
  _podman_sock="$(podman machine inspect podman-machine-default 2>/dev/null \
    | sed -n 's/.*"Path" *: *"\(.*api.sock\)".*/\1/p' | head -1)"
  [[ -S "$_podman_sock" ]] && export DOCKER_HOST="unix://$_podman_sock"
  unset _podman_sock
elif [[ -S /run/podman/podman.sock ]]; then
  export DOCKER_HOST="unix:///run/podman/podman.sock"
  alias kpodman="podman --url \$DOCKER_HOST"
fi

################################################################################
# Secrets (not tracked in git)
################################################################################
[[ -f "$HOME/.zshrc.secrets" ]] && source "$HOME/.zshrc.secrets"
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"
