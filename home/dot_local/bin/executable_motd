# An HTTP status code with Python's description of it.
tip_http() {
  local text
  text=$( {
    python3 -I -c '
import http
for s in http.HTTPStatus:
    print(f"{s.value} {s.phrase}\t{s.description}")' 2>/dev/null
    grep -v '^$' <<'HTTP'
444 No Response (nginx)	nginx closed the connection without sending anything; used to drop bad clients
494 Request Header Too Large (nginx)	a header or cookie is over large_client_header_buffers
495 SSL Certificate Error (nginx)	the client presented an invalid certificate in mutual TLS
496 SSL Certificate Required (nginx)	mutual TLS is on and the client sent no certificate
497 HTTP Request Sent to HTTPS Port (nginx)	plain HTTP arrived on a TLS listener
499 Client Closed Request (nginx)	the client gave up before nginx answered; often a client timeout shorter than the backend's
460 Client Closed Connection (AWS ALB)	the client closed the connection before the ALB's idle timeout ran out
463 Too Many Forwarded IPs (AWS ALB)	X-Forwarded-For held more than 30 addresses
464 Incompatible Protocol (AWS ALB)	the request's protocol doesn't match the target group's protocol version, e.g. gRPC to an HTTP/1.1 group
561 Unauthorized (AWS ALB)	the identity provider returned an error during ALB authentication
520 Unknown Error (Cloudflare)	the origin sent something empty, unknown or unexpected
521 Web Server Is Down (Cloudflare)	the origin refused the connection
522 Connection Timed Out (Cloudflare)	the TCP connection to the origin timed out
523 Origin Is Unreachable (Cloudflare)	no route to the origin, often bad DNS
524 A Timeout Occurred (Cloudflare)	connected to the origin, but it didn't answer in time
525 SSL Handshake Failed (Cloudflare)	the TLS handshake with the origin failed
526 Invalid SSL Certificate (Cloudflare)	the origin's certificate failed validation in Full (strict) mode
HTTP
  } | deal http)
  [ -n "$text" ] || return 1
  item "" http "${y}${text%%$'\t'*}${n} ${text#*$'\t'}"
}


# Cached daily in the background: outdated brew formulae and Flatpak updates.
updates() {
  local f=$cache/updates
  if [ -z "$(find "$f" -mtime -1 2>/dev/null)" ]; then
    (
      {
        command -v brew >/dev/null && printf 'brew %s\n' "$(brew outdated --quiet 2>/dev/null | wc -l | tr -d ' ')"
        command -v flatpak >/dev/null && printf 'flatpak %s\n' "$(flatpak remote-ls --updates --app 2>/dev/null | wc -l | tr -d ' ')"
      } > "$f.new" && mv "$f.new" "$f"
    ) >/dev/null 2>&1 &
  fi
  [ -s "$f" ] || { item "" updates "${d}checking…${n}"; return; }
  local s="" total=0 tool num
  while read -r tool num; do
    s="$s${s:+ · }$tool $num"; total=$((total + num))
  done < "$f"
  if [ "$total" = 0 ]; then s="${g}●${n} $s"; else s="${y}●${n} $s"; fi
  item "" updates "$s ${d}(checked $(date -r "$f" '+%a %H:%M'))${n}"
}

# CRD field descriptions, cached weekly in the background: upstream CRDs for
# tools not on the cluster, the cluster's own CRDs for the rest.
crd_dir=$cache/crd
crd_jq='
def fields($p; $depth):
  (.properties // {}) | to_entries[] | .key as $key |
  ([$p + "." + $key, ((.value.description // "") | gsub("\\s+"; " "))]),
  (if $depth < 3 then (.value | (.items // .) | fields($p + "." + $key; $depth + 1)) else empty end);
select(.kind == "CustomResourceDefinition")
| .spec.names.kind as $k
| (.spec.versions[] | select(.storage) | .schema.openAPIV3Schema.properties.spec)
| fields("spec"; 1) | select(.[1] != "") | [$k, .[0], .[1]] | @tsv'

crd_upstream() {
  local name=$1; shift
  for url in "$@"; do curl -fsSL --max-time 30 "$url" || return 1; echo '---'; done \
    | yq -o=json -I=0 '.' | jq -r "$crd_jq" > "$crd_dir/$name.tsv.new" \
    && [ -s "$crd_dir/$name.tsv.new" ] && mv "$crd_dir/$name.tsv.new" "$crd_dir/$name.tsv"
}

crd_cluster() {
  kubectl --context "$ctx" --request-timeout=5s get crd -o json 2>/dev/null \
    | jq -c --arg g "$2" '.items[] | select(.spec.group | test($g))' \
    | jq -r "$crd_jq" | grep -vE "^(${3:-^$})\b" > "$crd_dir/$1.tsv.new" \
    && [ -s "$crd_dir/$1.tsv.new" ] && mv "$crd_dir/$1.tsv.new" "$crd_dir/$1.tsv"
}

# CRDs of the charts kube_local's lessons install, at the versions they pin,
# from each lesson's "Example only" helm command. Lesson 02 is Flux, which has
# its own item. Output: lesson<TAB>Kind<TAB>path<TAB>description.
crd_lessons() {
  local docs=$HOME/repos/personal/kube_local/docs f lesson release chart repo version
  [ -d "$docs" ] || return
  for f in "$docs"/[0-9][0-9]-*.md; do
    lesson=$(basename "$f" .md)
    case $lesson in 02-*) continue ;; esac
    # Join continued lines, then pull release, chart, --repo and --version.
    sed -e ':a' -e '/\\$/N; s/\\\n *//; ta' "$f" \
      | awk '/^helm .*upgrade --install / && /--version/ {
          for (i = 1; i <= NF; i++) {
            if ($i == "--install") { rel = $(i + 1); ch = $(i + 2) }
            if ($i == "--repo") repo = $(i + 1)
            if ($i == "--version") ver = $(i + 1)
          }
          print rel, ch, (repo ? repo : "-"), ver; repo = "" }' \
      | while read -r release chart repo version; do
          helm template "$release" "$chart" ${repo:+$( [ "$repo" != - ] && echo --repo "$repo")} \
            --version "$version" --include-crds --set crds.enabled=true 2>/dev/null \
            | yq -o=json -I=0 '.' 2>/dev/null | jq -r "$crd_jq" 2>/dev/null \
            | sed "s/^/${lesson}\t/"
        done
  done | grep -vE "$(printf '\t')(AzureChaos|GCPChaos|PhysicalMachine|PhysicalMachineChaos|PodHttpChaos|PodIOChaos|PodNetworkChaos|WorkflowNode|RemoteCluster)$(printf '\t')" \
    | sort -u > "$crd_dir/lessons.tsv.new" \
    && [ -s "$crd_dir/lessons.tsv.new" ] && mv "$crd_dir/lessons.tsv.new" "$crd_dir/lessons.tsv"
}

crd_refresh() {
  mkdir -p "$crd_dir"
  [ -n "$(find "$crd_dir/.refreshed" -mtime -7 2>/dev/null)" ] && return
  touch "$crd_dir/.refreshed"
  (
    gh=https://raw.githubusercontent.com
    crd_upstream argocd $gh/argoproj/argo-cd/stable/manifests/crds/{application,appproject}-crd.yaml
    crd_lessons
    crd_cluster flux 'toolkit\.fluxcd\.io$'
    crd_cluster gateway '^gateway\.networking\.k8s\.io$'
    crd_cluster cilium '^cilium\.io$' 'CiliumEndpoint|CiliumIdentity|CiliumNode'
  ) >/dev/null 2>&1 &
}

# A random CRD field from a lesson's chart, at the version the lesson pins.
tip_lesson() {
  local f=$crd_dir/lessons.tsv entry lesson kind path desc
  # Lesson, then kind, then field, so big charts don't crowd out small ones.
  lesson=$(cut -f1 "$f" 2>/dev/null | sort -u | pick)
  [ -n "$lesson" ] || return 1
  kind=$(awk -F'\t' -v l="$lesson" '$1 == l { print $2 }' "$f" | sort -u | pick)
  entry=$(awk -F'\t' -v l="$lesson" -v k="$kind" '$1 == l && $2 == k' "$f" | deal lessons)
  [ -n "$entry" ] || return 1
  IFS=$'\t' read -r lesson kind path desc <<<"$entry"
  grep -qi 'deprecated' <<<"$desc" && return 1
  item "󰑴" "${lesson#*-}" "${y}${kind}${n} ${b}${path}${n}" "lesson ${lesson%%-*}"
  sentences <<<"$desc" | body
}

# A random field from the cached CRDs of $3.
tip_crd() {
  local icon=$1 label=$2 entry kind path desc
  entry=$(cat "$crd_dir/$3.tsv" 2>/dev/null | deal "crd-$3")
  [ -n "$entry" ] || return 1
  IFS=$'\t' read -r kind path desc <<<"$entry"
  grep -qi 'deprecated' <<<"$desc" && return 1
  item "$icon" "$label" "${y}${kind}${n} ${b}${path}${n}" "$3 CRD"
  sentences <<<"$desc" | body
}

# A PromQL idiom worth knowing.
tip_promql() {
  local entry expr what
  entry=$(grep -v '^$' <<'PROMQL' | deal promql
rate(http_requests_total[5m])	per-second average over 5m; use on counters, it handles resets
irate(http_requests_total[5m])	instant rate from the last two samples; for spiky graphs, not alerts
increase(http_requests_total[1h])	how much a counter grew in an hour; rate × range, extrapolated
sum by (job) (rate(http_requests_total[5m]))	rate first, then sum; summing counters before rate breaks on resets
histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))	p95 latency; keep the le label through the sum
topk(5, sum by (pod) (rate(container_cpu_usage_seconds_total[5m])))	five busiest pods by CPU
absent(up{job="node"})	returns 1 when the series is missing; alert on it, since up == 0 can't fire if there's no up
up == 0	targets Prometheus can't scrape
predict_linear(node_filesystem_avail_bytes[6h], 24 * 3600) < 0	disk full within a day, from the last 6 hours' trend
avg_over_time(node_load1[1h])	average of a gauge over a range
quantile_over_time(0.99, some_gauge[1h])	p99 of a gauge over time, not across series
changes(kube_pod_container_status_restarts_total[1h])	how often a value changed; good for flapping
resets(process_start_time_seconds[1d])	counter resets, i.e. restarts
rate(x[5m]) offset 1w	the same query a week ago; compare with the current value
max_over_time(rate(x[1m])[1h:1m])	a subquery: the worst 1m rate in the last hour, evaluated every 1m
a / on (instance) b	match only on instance when the label sets differ
a * on (pod) group_left (node) kube_pod_info	copy the node label onto a from kube_pod_info
a unless b	series in a with no matching series in b
x > bool 100	returns 0 or 1 instead of filtering
label_replace(up, "host", "$1", "instance", "(.*):.*")	derive a label with a regex
clamp_min(x, 0)	floor negative values, e.g. from counter math
count by (version) (kube_node_info)	how many nodes run each kubelet version
sum without (instance) (rate(x[5m]))	aggregate away one label, keep the rest
deriv(node_memory_MemAvailable_bytes[30m])	per-second slope of a gauge; rate is for counters only
x @ end()	pin a query to the end of the graph range
sum(rate(http_requests_total{code=~"5.."}[5m])) / sum(rate(http_requests_total[5m]))	error ratio; the core of most SLO alerts
1 - avg by (instance) (rate(node_cpu_seconds_total{mode="idle"}[5m]))	CPU busy fraction per host
node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes	free memory fraction; Available, not Free, counts reclaimable cache
container_memory_working_set_bytes	what the kubelet compares with limits for OOM and eviction, not RSS
rate(container_cpu_cfs_throttled_periods_total[5m]) / rate(container_cpu_cfs_periods_total[5m])	CPU throttling ratio; high with low usage means the limit is too tight
sum by (namespace) (kube_pod_container_resource_requests{resource="cpu"})	CPU requested per namespace
kube_pod_status_phase{phase="Pending"} == 1	pods stuck Pending
kube_deployment_status_replicas_available / kube_deployment_spec_replicas	fraction of desired replicas available
max by (pod) (kube_pod_container_status_waiting_reason{reason="CrashLoopBackOff"})	pods in CrashLoopBackOff
kube_node_status_condition{condition="Ready", status="true"} == 0	NotReady nodes
increase(kube_pod_container_status_restarts_total[15m]) > 0	containers that restarted recently
kubelet_volume_stats_available_bytes / kubelet_volume_stats_capacity_bytes	PVC free space
rate(apiserver_request_total{code=~"5.."}[5m])	API server errors
histogram_quantile(0.99, sum by (le, verb) (rate(apiserver_request_duration_seconds_bucket[5m])))	API server p99 latency per verb
sum(rate(x_sum[5m])) / sum(rate(x_count[5m]))	average from a histogram or summary
sum(rate(x_bucket{le="0.3"}[5m])) / sum(rate(x_count[5m]))	fraction of requests under 300ms; needs that exact bucket
histogram_quantile(0.9, sum(rate(x[5m])))	the same on a native histogram: no le label, no _bucket suffix
histogram_count(rate(x[5m]))	request rate from a native histogram
sum(x) or vector(0)	show 0 instead of no data when nothing matches
absent_over_time(up{job="x"}[10m])	the series has been gone for 10 minutes
last_over_time(x[1h])	the latest sample in the last hour, even if the series stopped
time() - process_start_time_seconds	process uptime in seconds
probe_success == 0	blackbox exporter probes failing
probe_ssl_earliest_cert_expiry - time() < 86400 * 14	certificates expiring within two weeks
stddev_over_time(x[1h])	how noisy a gauge is
bottomk(5, x)	the five smallest series
count_values("version", kubelet_version_info)	count series per label value of the result
group by (namespace) (kube_pod_info)	just the label sets, value 1; cheap for joins
sort_desc(sum by (pod) (rate(container_network_receive_bytes_total[5m])))	busiest pods by network receive
delta(node_hwmon_temp_celsius[1h])	change in a gauge over a range; increase is for counters
count by (__name__) ({job="x"})	series per metric for one job: find cardinality
{__name__=~"node_.*"}	select by metric name with a regex
scrape_samples_scraped	samples per scrape per target; spikes mean a cardinality jump
prometheus_tsdb_head_series	active series in Prometheus; memory follows it
rate(x[$__rate_interval])	Grafana's interval that's always at least four scrapes
round(x, 0.1)	round to the nearest 0.1
a and b	series in a that also exist in b
x > 0 unless on (pod) kube_pod_status_phase{phase="Succeeded"} == 1	filter out finished pods
level:metric:operations	recording rule naming, e.g. job:http_requests:rate5m
for: 5m	an alert rule waits 5 minutes Pending before Firing
keep_firing_for: 10m	holds an alert Firing after the condition clears, stops flapping
PROMQL
)
  [ -n "$entry" ] || return 1
  IFS=$'\t' read -r expr what <<<"$entry"
  item "" promql "${y}${expr}${n}"
  printf '%s\n' "$what" | body
}

count() { [ -n "$1" ] && wc -l <<<"$1" | tr -d ' ' || echo 0; }

status() {
  local failed ufailed img uupd nodes ready flux fready s dot
  if command -v systemctl >/dev/null; then
    failed=$(systemctl list-units --failed --plain --no-legend 2>/dev/null | awk '{print $1}' | paste -sd' ' -)
    ufailed=$(systemctl --user list-units --failed --plain --no-legend 2>/dev/null | awk '{print $1}' | paste -sd' ' -)
    if [ -z "$failed$ufailed" ]; then s="${g}●${n} no failed units"
    else s="${r}●${n} failed: ${failed}${ufailed:+ (user) $ufailed}"; fi
    uupd=$(systemctl show uupd.service -p Result --value 2>/dev/null)
    [ -n "$uupd" ] && [ "$uupd" != success ] && s="$s  ${r}●${n} last update run: $uupd"
    item "" systemd "$s"
  fi
  if command -v rpm-ostree >/dev/null; then
    img=$(rpm-ostree status --json 2>/dev/null | jq -r '
      (first(.deployments[] | select(.booted)) | ."container-image-reference-digest" // .checksum)[7:15] as $b
      | (first(.deployments[] | select(.staged)) // {} | ."container-image-reference-digest" // "")[7:15] as $s
      | if $s != "" then "\u001b[33m●\u001b[0m \($b), \($s) staged: reboot to apply"
        else "\u001b[32m●\u001b[0m \($b), up to date" end' 2>/dev/null)
    [ -n "$img" ] && item "" image "$img"
  fi
  if kubectl config get-contexts "$ctx" >/dev/null 2>&1; then
    nodes=$(kubectl --context "$ctx" --request-timeout=1s get nodes --no-headers 2>/dev/null)
    if [ -z "$nodes" ]; then item "󱃾" "$ctx" "${d}○ stopped${n}"; return; fi
    ready=$(grep -cw Ready <<<"$nodes")
    flux=$(kubectl --context "$ctx" --request-timeout=1s get kustomizations.kustomize.toolkit.fluxcd.io,helmreleases.helm.toolkit.fluxcd.io -A \
      -o jsonpath='{range .items[*]}{.status.conditions[?(@.type=="Ready")].status}{"\n"}{end}' 2>/dev/null)
    fready=$(grep -c True <<<"$flux")
    dot=$g
    [ "$ready" = "$(count "$nodes")" ] && [ "$fready" = "$(count "$flux")" ] || dot=$r
    s="${dot}●${n} nodes $ready/$(count "$nodes") Ready"
    [ -n "$flux" ] && s="$s · Flux $fready/$(count "$flux") Ready"
    item "󱃾" "$ctx" "$s"
  fi
}

title="$(date '+%a %d %b %H:%M') · $(hostname -s)"
[ "$platform" = linux ] && title="$title · $(uptime -p)"
printf "${d}╭─${n} ${b}%s${n} ${d}%s${n}\n" "$title" "$(dashes $((cols - ${#title} - 4)))"

section status
status
updates

crd_refresh

divider
try tip_port; gap
try tip_http; gap
if [ "$platform" = linux ]; then
  try tip_tldr "" linux 'ss|ip-.*|lsof|strace|pactl|wpctl|nmcli.*|findmnt|lsblk|pgrep|dmesg|taskset|ionice|sysctl|ethtool|tc|nft|mokutil|rpm-ostree.*|bootc.*|flatpak|udisksctl|cryptsetup.*|btrfs-.*|chrt|dig|tcpdump|getent|setfacl|ldd|readelf|nsenter|unshare|ip|perf|bpftool'; gap
else
  try tip_tldr "" macos 'defaults|diskutil|pmset|scutil|networksetup|log|mdfind|mdutil|caffeinate|softwareupdate|tmutil|codesign|spctl|xattr|system_profiler|sysctl|dtrace|vm_stat|powermetrics|ditto|hdiutil|security|nettop|route|csrutil|lsof|dig|tcpdump'; gap
fi
try tip_tldr "" container 'podman-.*|skopeo|buildah.*|crictl|k3d.*|cosign|nerdctl|dive|ctr'; gap
if [ "$platform" = linux ]; then
  { [ $((RANDOM % 2)) = 0 ] && try tip_directive; } \
    || try tip_tldr "" systemd 'systemctl-.*|journalctl|systemd-.*|networkctl|resolvectl|busctl|coredumpctl|loginctl|hostnamectl|timedatectl|bootctl|udevadm'
else
  { [ $((RANDOM % 2)) = 0 ] && try tip_plist; } \
    || try tip_tldr "" launchd 'launchctl|launchd|plutil'
fi
gap
# One in six AWS tips is EKS; the rest are any service.
if [ $((RANDOM % 6)) = 0 ]; then try tip_tldr "" aws 'aws-eks|eksctl'; else try tip_tldr "" aws 'aws|aws-.*'; fi

gap
{ [ $((RANDOM % 2)) = 0 ] && try tip_explain; } \
  || try tip_tldr "󱃾" k8s 'kubectl-.*|helm.*|kustomize|kubeconform|stern|kubectx|kubens'; gap
if [ $((RANDOM % 2)) = 0 ]; then try tip_crd "󰛳" gateway gateway; else try tip_crd "󰛳" cilium cilium; fi && gap
{ [ $((RANDOM % 3)) != 0 ] && try tip_crd "" flux flux; } || try tip_tldr "" flux 'flux-.*'; gap
{ [ $((RANDOM % 3)) != 0 ] && try tip_crd "" argocd argocd; } || try tip_tldr "" argocd 'argocd.*'; gap
try tip_lesson && gap
try tip_promql

gap
try tip_man
[ "$platform" = linux ] && { gap; try tip_bpf; }

printf "${d}╰─${n}\n"
